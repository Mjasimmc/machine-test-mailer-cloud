# =============================================================================
# Multi-Tenant SaaS Form Builder - Environment Configuration Blueprint
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Configuration (Non-sensitive / Static)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. Infrastructure Boundary: HashiCorp Vault Secrets Management
# -----------------------------------------------------------------------------
# Set VAULT_ENABLED=true in staging/production to source secrets strictly from Vault.
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token-saas-platform
VAULT_PATH=secret/data/saas-api

# -----------------------------------------------------------------------------
# 3. Primary Authoritative Database (MongoDB)
# -----------------------------------------------------------------------------
# In production, fetched from Vault (MONGODB_URI)
MONGODB_URI=mongodb://127.0.0.1:27017/saas_db

# -----------------------------------------------------------------------------
# 4. Distributed Shared State & Pub/Sub (Redis)
# -----------------------------------------------------------------------------
# Used for Socket.IO Redis adapter, distributed rate limiting, and cache.
# If omitted, application runs with local in-memory fallbacks.
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# 5. Authentication & JWT Security
# -----------------------------------------------------------------------------
# In production, fetched from Vault (JWT_SECRET)
JWT_SECRET=super-secret-jwt-key-for-saas-platform-change-in-prod
JWT_EXPIRATION=7d

# -----------------------------------------------------------------------------
# 6. Object Storage Boundary (Local / S3 Compatible)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=saas-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadminpassword

# -----------------------------------------------------------------------------
# 7. Seed Admin Account Initial Provisioning
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@saas.local
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=SaaS Administrator
